{
  "name": "DemoSpark",
  "description": "Turn your product into a clickable, interactive demo in minutes. Embed anywhere, track engagement, and boost conversions. Perfect for marketers, sales, and startups. Try DemoSpark today!",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run appinfo && concurrently -k -n content,next -c blue,green \"contentlayer2 dev\" \"cross-env PORT=6006 NODE_OPTIONS='--no-warnings' next dev --turbopack\"",
    "build": "npm run appinfo && next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "lint": "eslint --fix app components lib layouts scripts",
    "pretty": "prettier --write .",
    "appinfo": "node ./scripts/generateAppInfo.mjs",
    "postinstall": "patch-package"
  },
